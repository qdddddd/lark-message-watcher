# Bot service
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_VERIFICATION_TOKEN=xxx
FEISHU_ENCRYPT_KEY=
MATCH_PATTERN='(?ms)^Features update summary:\s*\d{4}-\d{2}-\d{2}\s+.*?^missed\s+0\s*$'
SCRIPT_COMMAND=python scripts/example_task.py
SCRIPT_TIMEOUT_SEC=30
LOG_LEVEL=INFO

# Optional polling config
POLLING_INTERVAL_FAST_SEC=30
POLLING_INTERVAL_SLOW_SEC=300
POLLING_FAST_START_HOUR=14
POLLING_FAST_END_HOUR=15
POLLING_HISTORY_DAYS=3
POLLING_PAGE_SIZE=50
